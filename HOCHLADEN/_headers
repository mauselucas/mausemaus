# Kopfzeilen fuer Netlify. Diese Datei wird beim Hochladen einfach
# mitgeschickt -- kein Bauwerkzeug, keine netlify.toml noetig.
#
# Bewusst KEINE Content-Security-Policy: Sie wuerde an drei Stellen dieser
# Seite scheitern -- am document.write im Polyfill-Lader, am Nachladen von
# highlight.js aus dem Netz (assets/inhalt.js) und an den YouTube-Fenstern.
# Eine CSP ist ein eigenes Vorhaben mit eigener Pruefung, kein Nebenprodukt.

/assets/seed.js
  # AUSNAHME von der Jahresregel unten. seed.js wird bei JEDEM Hochladen neu
  # geschrieben (tests/hochladen.mjs) und seit Kurzem von db.js NACHGELADEN,
  # statt fest in der Seite zu stehen -- die Adresse traegt deshalb keinen
  # ?v=-Stempel, an dem der Browser eine neue Fassung erkennen koennte.
  # Mit "immutable" bekaeme ein Besucher ein Jahr lang die alten Notfall-Daten.
  Cache-Control: public, max-age=0, must-revalidate

/assets/*
  # Ein Jahr, unveraenderlich -- das ist NUR deshalb sicher, weil jede
  # Adresse in den HTML-Seiten einen ?v=-Stempel traegt (tests/stempel.mjs).
  # Aendert sich eine Datei, aendert sich der Stempel und damit die Adresse:
  # der Browser holt sie dann als etwas Neues, statt die alte weiterzureichen.
  # Ohne diesen Stempel waere diese Zeile gefaehrlich.
  Cache-Control: public, max-age=31536000, immutable

/*.html
  # Die Seiten selbst NICHT festhalten: sie tragen die Stempel und die
  # Teilen-Vorschau, beide muessen sofort ankommen.
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate

/*
  # Verrät Fremdseiten beim Weggehen nur die Herkunft, nicht die genaue Seite.
  Referrer-Policy: strict-origin-when-cross-origin
  # Verbietet dem Browser zu raten, was eine Datei ist -- ein hochgeladenes
  # Bild kann so nicht als Skript ausgefuehrt werden.
  X-Content-Type-Options: nosniff
  # Die Seite darf nicht in einen fremden Rahmen gesteckt werden.
  X-Frame-Options: DENY
